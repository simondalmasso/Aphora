{
  "name": "sos-sf",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 8787",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run --exclude 'tests/contract/**'",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run test:contract && npm run build && npm run test:e2e",
    "cf:types": "wrangler types",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "verify:remote": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "^0.185.1",
    "vite": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "^0.185.3",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "engines": {
    "node": ">=22"
  }
}
