{
  "name": "sos-sf",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 8787",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --exclude 'tests/contract/**' --exclude 'tests/worker/**'",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:worker": "node scripts/run-worker-tests.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run test:contract && npm run build && npm run test:worker && npm run test:e2e",
    "cf:types": "wrangler types",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "verify:remote": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260801.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "wrangler": "4.119.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
