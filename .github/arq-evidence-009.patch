diff --git a/scripts/finalize-evidence.mjs b/scripts/finalize-evidence.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..31bc13fdc7f22f5b4976f8967ef2bbfe11305161
--- /dev/null
+++ b/scripts/finalize-evidence.mjs
@@ -0,0 +1,93 @@
+import { createHash } from 'node:crypto';
+import { readFile, readdir, stat, writeFile } from 'node:fs/promises';
+import { join, relative, resolve } from 'node:path';
+
+const root = process.cwd();
+const evidenceDir = resolve(root, process.env.EVIDENCE_DIR ?? 'artifacts/current-run');
+if (!evidenceDir.startsWith(resolve(root, 'artifacts') + '/')) throw new Error('EVIDENCE_DIR_OUTSIDE_ARTIFACTS');
+
+async function walk(directory) {
+  const entries = await readdir(directory);
+  const files = [];
+  for (const entry of entries) {
+    const path = join(directory, entry);
+    if ((await stat(path)).isDirectory()) files.push(...await walk(path));
+    else files.push(path);
+  }
+  return files;
+}
+
+const all = (await walk(evidenceDir)).filter((path) => !path.endsWith('evidence-manifest.json'));
+const rows = [];
+for (const path of all) {
+  const content = await readFile(path);
+  rows.push({
+    path: relative(evidenceDir, path).replaceAll('\\', '/'),
+    bytes: content.byteLength,
+    sha256: createHash('sha256').update(content).digest('hex'),
+  });
+}
+
+const forbidden = rows.filter((row) => /(^|\/)(v1|pulso|old)(\/|[-_.])/i.test(row.path));
+if (forbidden.length) throw new Error(`STALE_EVIDENCE_PATHS:${forbidden.map((row) => row.path).join(',')}`);
+
+const expectedScreenshots = ['360', '390', '768', '1024', '1440']
+  .map((width) => `screenshots/dashboard-live-${width}.png`);
+for (const expected of expectedScreenshots) {
+  if (!rows.some((row) => row.path === expected)) throw new Error(`MISSING_DETERMINISTIC_SCREENSHOT:${expected}`);
+}
+
+const proofRow = rows.find((row) => row.path === 'deployment-proof.json');
+if (proofRow) {
+  const proof = JSON.parse(await readFile(join(evidenceDir, proofRow.path), 'utf8'));
+  if (proof.source_commit !== process.env.GITHUB_SHA) throw new Error('DEPLOYMENT_PROOF_SHA_MISMATCH');
+}
+
+const manifest = {
+  schemaVersion: '1.0',
+  decisionId: 'SOS-SF-AUD-V3-EVIDENCE-009',
+  audHold: 'ACTIVE',
+  sourceCommit: process.env.GITHUB_SHA ?? null,
+  runId: process.env.GITHUB_RUN_ID ?? null,
+  generatedAt: new Date().toISOString(),
+  cleanDirectory: true,
+  deterministicScenario: 'LIVE_FIXED',
+  fileCount: rows.length,
+  files: rows.sort((a, b) => a.path.localeCompare(b.path)),
+};
+await writeFile(join(evidenceDir, 'evidence-manifest.json'), `${JSON.stringify(manifest, null, 2)}\n`);
+console.log(JSON.stringify({ event: 'evidence_finalized', fileCount: rows.length, cleanDirectory: true }));
